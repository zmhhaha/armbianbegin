# Local ARM64 image definition for Drone Kubernetes runner.
# The upstream Dockerfile pins EOL Alpine 3.13; use maintained Alpine 3.20.
FROM alpine:3.20 AS alpine

RUN apk add --no-cache ca-certificates

FROM scratch

LABEL org.opencontainers.image.title="drone-runner-kube"

COPY --from=alpine /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY release/linux/arm64/drone-runner-kube /usr/local/bin/drone-runner-kube

ENTRYPOINT ["/usr/local/bin/drone-runner-kube"]
