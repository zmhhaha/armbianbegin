# 唯一的对外 server 块：全部 ${BASE_DOMAIN} 及其子域共用（端口 ${HTTPS_PORT}）
#
# 设计要点（改之前先读 ../docs/vps-ingress-design.md §4）：
#   - 通配符证书覆盖所有子域 → 新增服务**不需要改这个文件** ✓
#   - 所有请求都交给 frps 的 HTTP vhost 端口，由 frps 按 Host 分流 ✓
#   - Host 必须原样传给后端：各服务靠它路由，oauth2-proxy 还靠它生成回调 URL ✓
#
# 由 install.sh 安装到 /etc/nginx/sites-available/<域名>.conf

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    # 只用于 ACME http-01 兜底（通配符证书走 DNS-01，其实用不到）
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    # 注：老版本 nginx（<1.25）用这个写法；新版本会有 deprecation 警告但不影响功能
    #
    # ★ default_server 不能省：它让这个块成为 443 的兜底块，从而与下面那句
    #   "保险丝" 的意图一致。不加的话，443 的默认块是"按文件名排序第一个监听 443
    #   的 server"，其它配置文件一加进来就可能把兜底抢走 ——
    #   2026-10-18 实测踩过：新增 custom-llm-proxy.conf（排序在本文件之前）后，
    #   根域 panghuer.top 落到它的 location / { return 404; }，根域整站 404 ✗
    listen ${HTTPS_PORT} ssl http2 default_server;
    listen [::]:${HTTPS_PORT} ssl http2 default_server;

    # 裸域名必须显式列出：nginx 的 *.domain 只匹配子域，不匹配 panghuer.top 本身 ✗
    server_name ${BASE_DOMAIN} *.${BASE_DOMAIN};

    # ★ 请求头缓冲：oauth2-proxy 的会话 cookie 会分成多个分片由浏览器回传，
    #   Cookie 头可达数万字节 → 默认每行 8k 会返回 400 Bad Request ✗
    client_header_buffer_size   16k;
    large_client_header_buffers 8 32k;

    ssl_certificate     /etc/letsencrypt/live/${BASE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BASE_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    # 保险丝：未匹配到任何 server_name 时落到这里，避免泄漏默认站点
    # ★ 静态资源：在 VPS 上缓存 ✓（命中后完全不碰家里上行 ✓✓）
    #   注意：带 Set-Cookie 的响应不会被缓存 ✓（安全边界，别加 proxy_ignore_headers Set-Cookie ✗）
    location ~* ^/(assets|static|plugins|oauth2/static)/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Accept-Encoding   "";

        proxy_cache            static_cache;
        proxy_cache_key        "$host$request_uri";
        proxy_cache_valid      200 14d;
        proxy_cache_use_stale  error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock       on;
        proxy_ignore_headers   Cache-Control Expires;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # Host 原样传递（各服务的路由与回调 URL 都依赖它）
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # ★ 少了这一行：oauth2-proxy 会以为是 http → 无限重定向 ✗
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Accept-Encoding \;
        include /etc/nginx/snippets/beian-footer.conf;
        proxy_set_header X-Forwarded-Host  $host;

        # ★ 少了这两行：DSH 的 WebSocket 建不起来 → 界面"能打开但操作卡死" ✗
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        # ★ 响应头缓冲：oauth2-proxy 的会话 cookie 超过 4KB，会被拆成多个
        #   Set-Cookie 头 → 默认 4KB 缓冲不够 → nginx 报 "upstream sent too big
        #   header" 并返回 502 ✗。这几个值必须放宽。
        proxy_buffer_size       64k;
        proxy_buffers           8 64k;
        proxy_busy_buffers_size 128k;

        # 长连接 / 流式响应
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering    off;
    }
}
