# Authenticated workbench responses must bypass the wildcard site's static
# cache and HTML rewriting. Render only BASE_DOMAIN/HTTPS_PORT so that nginx
# request variables remain literal.
map "$uri|$upstream_status|$upstream_http_cache_control" $video_service_cache_control {
    default "no-store";
    # Only authenticated 200 responses containing measured public libraries or
    # the font may be cached by this browser. Never enable a shared proxy cache.
    "~^/dev/animations/assets/[0-9a-f]{64}/(gsap\.min\.js|NotoSansCJK-Regular\.ttc|three\.module\.min\.js)\|200\|private, max-age=31536000, immutable$" "private, max-age=31536000, immutable";
}

server {
    listen ${HTTPS_PORT} ssl http2;
    listen [::]:${HTTPS_PORT} ssl http2;
    server_name video-service.${BASE_DOMAIN};

    # OAuth callback queries contain short-lived authorization codes.
    access_log off;

    ssl_certificate     /etc/letsencrypt/live/${BASE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BASE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_header_buffer_size 16k;
    large_client_header_buffers 8 32k;

    location / {
        # frps routes the original Host to the existing OAuth proxy on 4180.
        # The workbench's internal port 8089 is never an FRP target.
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_redirect off;
        proxy_intercept_errors off;

        # API, previews, exports and all failed/auth responses remain no-store.
        proxy_cache off;
        proxy_cache_bypass 1;
        proxy_no_cache 1;
        proxy_hide_header Cache-Control;
        add_header Cache-Control $video_service_cache_control always;

        proxy_buffer_size 64k;
        proxy_buffers 8 64k;
        proxy_busy_buffers_size 128k;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
