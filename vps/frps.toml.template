# frps configuration template.
#
# Rendered to /etc/frp/frps.toml by install.sh:
#   - the placeholder in the auth.token line is replaced with the FRP_TOKEN environment variable
#   - the real token never enters git
# Design doc: ../docs/vps-ingress-design.md
#
# NOTE: keep this file ASCII-only. frp's TOML parser rejects non-ASCII characters inside
# comments ("invalid character in comment"), so all prose lives in README.md instead.

# Tunnel control port -- the only tunnel port exposed to the internet (token protected).
bindPort = 7000

auth.method = "token"
auth.token = "${FRP_TOKEN}"

# TLS for the tunnel layer (self-signed; the client pairs with transport.tls.enable = true).
transport.tls.force = true

# Only these ports may be used for TCP proxies.
# HTTP vhost mode needs no port (all hostnames share vhostHTTPPort); this range is
# reserved for non-HTTP services such as SSH or databases.
allowPorts = [{ start = 18080, end = 18100 }]

# HTTP vhost: every *.domain shares this single port; frps routes by the Host header.
vhostHTTPPort = 8080

# Hardening: bind all proxy ports to loopback only -- the sole public entry point is
# nginx on 443, while 8080 and 18080+ are unreachable from outside.
proxyBindAddr = "127.0.0.1"

log.to = "console"
log.level = "info"