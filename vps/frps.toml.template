# frps 配置模板
#
# 由 install.sh 渲染到 /etc/frp/frps.toml：
#   - ${FRP_TOKEN} 从环境变量注入（**真实 token 永不进 git** ✓）
# 设计文档：../docs/vps-ingress-design.md

# 隧道控制端口 —— 唯一对公网开放的隧道端口（token 保护 ✓）
bindPort = 7000

auth.method = "token"
auth.token = "${FRP_TOKEN}"

# 隧道层 TLS（自签；客户端 transport.tls.enable = true 与之配对）
transport.tls.force = true

# 只允许这段端口做 TCP 代理。
# HTTP vhost 模式不需要端口 ✓（所有域名共用 vhostHTTPPort），
# 这一段是给"非 HTTP 服务"（SSH/数据库等）留的。
allowPorts = [{ start = 18080, end = 18100 }]

# HTTP vhost：全部 *.域名 共用一个端口，frps 按 Host 头分流到对应代理
vhostHTTPPort = 8080

# ★ 加固：所有代理端口只绑本机 ——
#   公网唯一入口是 nginx 的 443，8080/18080 段在外面根本连不上
proxyBindAddr = "127.0.0.1"

log.to = "console"
log.level = "info"
